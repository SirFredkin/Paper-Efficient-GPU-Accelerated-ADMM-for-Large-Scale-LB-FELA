@article{Anderheggen_1972,
   author = {Anderheggen, E. and Knöpfel, H.},
   title = {Finite element limit analysis using linear programming},
   journal = {International journal of solids and structures},
   volume = {8},
   number = {12},
   pages = {1413-1431},
   abstract = {This paper concerns the development of numerical methods for the determination of the ultimate load of two- and three-dimensional structures assuming an ideal rigid-plastic behavior of the material. According to the classical plasticity theory the ultimate load problem can be mathematically formulated as the problem of finding the maximum or minimum of a linear function, whose independent variables are subjected to inequality constraints. In order to use linear programming techniques these generally nonlinear constraints are approximated by sets of linear inequality restrictions. Linear equilibrium or kinematic compatibility equations have then to be formulated, the corresponding coefficients being determined by virtual work methods. This requires the assumption of parametric stress and displacement fields, which are constructed by mean of finite element procedures. Numerical results for two plate-bending models are presented and some possible plate-stretching models are described and discussed. Paбoтa кacaeтcя paзpaбoтки чиcлeнныч мeтoдoв oпpeдeлeния пpeдeльнoй нaгpyзки двyчи тpeчмepныч кoнcтpyкций, пpeдпoлaгaя идeaльнo жecткo-плacтичecкoe пoвeдeниe мaтepиaлa. B coглacии c клaccичecкoй тeopиeй плacтичнocти, зaдaчa пpeдeльнoй нaгpyзки oпpeдeляeтcя мaтeмaтичecкoй фopмyлoй в cмыcлe зaдaчи вычиcлeния мaкcимyмa или минимyмa линeйнoй фyнкции, нeзaвиcимыe пepeмeнныe кoтopoй пoдвepжeнныe нepaвнoмepным cилaм cвязи. C цeлью иcпoльзoвaния мeтoдa линeйнoгo пpoгpaммиpoв aния, пpиближaютcя эти вooбщe нeлинeйныe cилы cвяэи pядaми oгpaничeний линeйныч нepaвeнcтв. зaтeм, мoжнo oпpeдeлить линeйныe ypaвнeния paвнoвecия или кинeмaтичecкoй coвмecтимocти, пpичeм cooтвeтcтвyющиe кoзффициeнты пoлyчaютcя c пoмoщью мeтoдoв виpтyaльнoй paбoты. Этo тpeбyeт пpиeмa пoлeй пapaмeтpичecкич нaпpяжeний и пepeмeщeний, пoлyчeнныч c пoмoщью мeтoдa кoнeчнoгo элeмeнтa. Дaютcя чиcлeнныe peзyльтaты для двyч мoдeлeй иeгибa плacтинoк. Oпиcывaютcя и oбcyждaютcя тaкжe вoзмoжнocть иccлeдoвaния мo